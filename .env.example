# Copy to .env and fill in. Never commit .env.

# Long random string. Signs sessions and encrypts the merchants' saved API keys.
# Changing it logs everyone out and makes saved WhatsApp/Gemini keys unreadable.
SECRET_KEY=

# sqlite:///./mrigel.db locally; a Postgres URL in production (Neon, Supabase, Render...)
DATABASE_URL=sqlite:///./mrigel.db

# 1 behind HTTPS (production)
SECURE_COOKIES=0
# 1 when running behind a proxy that sets X-Forwarded-For (Render, Railway, Fly, nginx)
TRUST_PROXY=0

# ar or fr
DEFAULT_LANG=ar

# Optional: a Gemini key used for every store that has not set its own
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Follow-ups run in the web process every minute (1), or call POST /tasks/run with this token from a cron
RUN_JOBS=1
CRON_TOKEN=

# 1 shows a "try the demo" button and creates a demo store with fake orders
DEMO_MODE=0

WHATSAPP_API_VERSION=v21.0
